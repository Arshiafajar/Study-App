rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Tasks: everyone can read, only your teacher account can write
    match /tasks/{id} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == "YOUR_EMAIL_HERE";
    }
    // Ticks: Maida's app reads and writes these
    match /done/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(["at"]);
      allow delete: if true;
    }
  }
}
